<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generator Grafic 2D"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:textColor="#1A237E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numar de valori (2-10):"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/countSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:drawable/spinner_background"
            android:paddingStart="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduceti valorile:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/valuesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip grafic:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/chartTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioPie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pie Chart"
                android:checked="true"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Column"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bar Chart"
                android:textSize="14sp" />

        </RadioGroup>

        <Button
            android:id="@+id/showChartButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Afiseaza Graficul"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
